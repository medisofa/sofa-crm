+/** Filas pegadas desde Excel (tabulador) o CSV (; o ,) → arreglo de celdas */
+export function splitText(textIn) {
+  const lines = String(textIn || '').replace(/^﻿/, '').replace(/\r/g, '').split('\n').filter((l) => l.trim());
+  if (!lines.length) return [];
+  const sep = lines[0].includes('\t') ? '\t' : lines[0].includes(';') ? ';' : ',';
+  const split = (l) => {
+    const out = []; let cur = ''; let q = false;
+    for (let i = 0; i < l.length; i += 1) {
+      const ch = l[i];
+      if (ch === '"') { if (q && l[i + 1] === '"') { cur += '"'; i += 1; } else q = !q; }
+      else if (ch === sep && !q) { out.push(cur.trim()); cur = ''; }
+      else cur += ch;
+    }
+    out.push(cur.trim());
+    return out;
   };
+  return lines.map(split);
+}
 
