diff --git a/js/utils/xlsx-lite.js b/js/utils/xlsx-lite.js
new file mode 100644
index 0000000..a18a51c
--- /dev/null
+++ b/js/utils/xlsx-lite.js
@@ -0,0 +1,162 @@
+/**
+ * SOFA 1.7.6 · Lector mínimo de Excel (.xlsx) sin librerías externas.
+ * Lee la PRIMERA hoja de un .xlsx y la devuelve como filas de texto.
+ * Usa solo lo que trae el navegador: DecompressionStream (ZIP) y DOMParser (XML).
+ * No ejecuta fórmulas: toma el último valor que Excel guardó en la celda.
+ * Las fechas de Excel (números de serie con formato de fecha) salen como AAAA-MM-DD.
+ * No lee el formato antiguo .xls (binario): en ese caso pide guardar como .xlsx o CSV.
+ */
+
+const u16 = (b, o) => b[o] | (b[o + 1] << 8);
+const u32 = (b, o) => (b[o] | (b[o + 1] << 8) | (b[o + 2] << 16) | (b[o + 3] << 24)) >>> 0;
+
+/** Índice de archivos del ZIP: nombre → { method, size, offset } */
+function zipIndex(bytes) {
+  // Fin del directorio central: firma 0x06054b50, buscando desde el final (el comentario puede medir hasta 64 KB)
+  let eocd = -1;
+  for (let i = bytes.length - 22; i >= Math.max(0, bytes.length - 22 - 65535); i -= 1) {
+    if (u32(bytes, i) === 0x06054b50) { eocd = i; break; }
+  }
+  if (eocd < 0) throw new Error('El archivo no es un Excel .xlsx válido. Si es un .xls antiguo, ábralo en Excel y guárdelo como .xlsx o CSV.');
+  const count = u16(bytes, eocd + 10);
+  let p = u32(bytes, eocd + 16);
+  const dec = new TextDecoder();
+  const files = {};
+  for (let n = 0; n < count; n += 1) {
+    if (u32(bytes, p) !== 0x02014b50) throw new Error('El archivo .xlsx está dañado (directorio interno inválido). Ábralo en Excel y vuelva a guardarlo.');
+    const method = u16(bytes, p + 10);
+    const size = u32(bytes, p + 20);
+    const nameLen = u16(bytes, p + 28); const extraLen = u16(bytes, p + 30); const commentLen = u16(bytes, p + 32);
+    const offset = u32(bytes, p + 42);
+    const name = dec.decode(bytes.subarray(p + 46, p + 46 + nameLen));
+    files[name] = { method, size, offset };
+    p += 46 + nameLen + extraLen + commentLen;
+  }
+  return files;
+}
+
+async function zipText(bytes, files, name) {
+  const f = files[name];
+  if (!f) return null;
+  const lh = f.offset;
+  if (u32(bytes, lh) !== 0x04034b50) throw new Error('El archivo .xlsx está dañado. Ábralo en Excel y vuelva a guardarlo.');
+  const start = lh + 30 + u16(bytes, lh + 26) + u16(bytes, lh + 28);
+  const data = bytes.subarray(start, start + f.size);
+  if (f.method === 0) return new TextDecoder().decode(data);
+  if (f.method !== 8) throw new Error('El archivo .xlsx usa una compresión no compatible. Guárdelo de nuevo desde Excel.');
+  if (typeof DecompressionStream === 'undefined') throw new Error('Este navegador no puede leer .xlsx. Actualícelo, o guarde el archivo como CSV y súbalo así.');
+  const stream = new Blob([data]).stream().pipeThrough(new DecompressionStream('deflate-raw'));
+  return new Response(stream).text();
+}
+
+const xml = (text) => new DOMParser().parseFromString(text, 'application/xml');
+const all = (node, tag) => Array.from(node.getElementsByTagNameNS('*', tag));
+const first = (node, tag) => node.getElementsByTagNameNS('*', tag)[0] || null;
+const textOf = (node) => all(node, 't').map((t) => t.textContent).join('');
+
+/** "AB12" → índice de columna 27 (base 0) */
+export function colIndex(ref) {
+  const m = /^([A-Z]+)/.exec(String(ref || '').toUpperCase());
+  if (!m) return -1;
+  let n = 0;
+  for (const ch of m[1]) n = n * 26 + (ch.charCodeAt(0) - 64);
+  return n - 1;
+}
+
+/** Número de serie de Excel (sistema 1900) → AAAA-MM-DD */
+export function serialToISO(serial) {
+  const d = new Date(Date.UTC(1899, 11, 30) + Math.floor(Number(serial)) * 86400000);
+  return d.toISOString().slice(0, 10);
+}
+
+const BUILTIN_DATE = new Set([14, 15, 16, 17, 22, 27, 30, 36, 45, 46, 47, 50, 57]);
+/** ¿El código de formato es de fecha? (d, m, y fuera de comillas y corchetes) */
+export function isDateFormat(code) {
+  const c = String(code || '').replace(/"[^"]*"/g, '').replace(/\[[^\]]*\]/g, '').replace(/\\./g, '');
+  return /[dy]/i.test(c) || /m{1,4}.*[dy]|[dy].*m{1,4}/i.test(c);
+}
+
+/** Estilos de celda → ¿es fecha? (por índice del atributo s) */
+async function dateStyles(bytes, files) {
+  const txt = await zipText(bytes, files, 'xl/styles.xml');
+  if (!txt) return [];
+  const doc = xml(txt);
+  const custom = {};
+  all(doc, 'numFmt').forEach((n) => { custom[Number(n.getAttribute('numFmtId'))] = n.getAttribute('formatCode'); });
+  const xfs = first(doc, 'cellXfs');
+  if (!xfs) return [];
+  return all(xfs, 'xf').map((x) => {
+    const id = Number(x.getAttribute('numFmtId') || 0);
+    return BUILTIN_DATE.has(id) || (custom[id] != null && isDateFormat(custom[id]));
+  });
+}
+
+/** Ruta de la primera hoja según workbook.xml y sus relaciones */
+async function firstSheetPath(bytes, files) {
+  const wb = await zipText(bytes, files, 'xl/workbook.xml');
+  const rels = await zipText(bytes, files, 'xl/_rels/workbook.xml.rels');
+  if (wb && rels) {
+    const sheet = first(xml(wb), 'sheet');
+    const rid = sheet && (sheet.getAttribute('r:id') || sheet.getAttributeNS('http://schemas.openxmlformats.org/officeDocument/2006/relationships', 'id'));
+    const rel = rid && all(xml(rels), 'Relationship').find((r) => r.getAttribute('Id') === rid);
+    if (rel) {
+      const target = rel.getAttribute('Target').replace(/^\/+/, '');
+      const path = target.startsWith('xl/') ? target : `xl/${target}`;
+      if (files[path]) return path;
+    }
+  }
+  return Object.keys(files).filter((n) => /^xl\/worksheets\/sheet\d+\.xml$/.test(n)).sort()[0] || null;
+}
+
+const numText = (v) => {
+  const n = Number(v);
+  if (!Number.isFinite(n)) return String(v);
+  return String(Math.round(n * 1e6) / 1e6);   // 1500.0000000001 → "1500"
+};
+
+/**
+ * Lee la primera hoja de un .xlsx.
+ * @param {ArrayBuffer} buffer contenido del archivo
+ * @returns {Promise<string[][]>} filas (sin las vacías), cada celda como texto
+ */
+export async function readXlsx(buffer) {
+  const bytes = new Uint8Array(buffer);
+  if (bytes.length < 4 || u32(bytes, 0) !== 0x04034b50) {
+    if (bytes[0] === 0xd0 && bytes[1] === 0xcf) throw new Error('Es un Excel antiguo (.xls). Ábralo en Excel y guárdelo como .xlsx o CSV, y vuelva a subirlo.');
+    throw new Error('El archivo no es un Excel .xlsx. Súbalo como .xlsx o CSV.');
+  }
+  const files = zipIndex(bytes);
+  const path = await firstSheetPath(bytes, files);
+  if (!path) throw new Error('El archivo .xlsx no tiene hojas con datos.');
+  const sstText = await zipText(bytes, files, 'xl/sharedStrings.xml');
+  const shared = sstText ? all(xml(sstText), 'si').map(textOf) : [];
+  const isDate = await dateStyles(bytes, files);
+  const doc = xml(await zipText(bytes, files, path));
+  if (doc.getElementsByTagName('parsererror').length) throw new Error('No se pudo leer la hoja del archivo. Ábralo en Excel y vuelva a guardarlo.');
+  const out = [];
+  all(doc, 'row').forEach((row, ri) => {
+    const cells = [];
+    let next = 0;
+    all(row, 'c').forEach((c) => {
+      const ref = c.getAttribute('r');
+      const ci = ref ? colIndex(ref) : next;
+      next = ci + 1;
+      const t = c.getAttribute('t') || 'n';
+      const v = first(c, 'v');
+      let val = '';
+      if (t === 's') val = v ? (shared[Number(v.textContent)] ?? '') : '';
+      else if (t === 'inlineStr') { const is = first(c, 'is'); val = is ? textOf(is) : ''; }
+      else if (t === 'str' || t === 'e') val = v ? v.textContent : '';
+      else if (t === 'b') val = v ? (v.textContent === '1' ? 'VERDADERO' : 'FALSO') : '';
+      else if (t === 'd') val = v ? v.textContent.slice(0, 10) : '';
+      else if (v) {
+        const s = Number(c.getAttribute('s') || 0);
+        val = isDate[s] ? serialToISO(v.textContent) : numText(v.textContent);
+      }
+      cells[ci] = String(val).trim();
+    });
+    for (let i = 0; i < cells.length; i += 1) if (cells[i] == null) cells[i] = '';
+    if (cells.some((x) => x !== '')) out[ri] = cells;
+  });
+  return out.filter(Boolean);
+}
