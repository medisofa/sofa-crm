+/**
+ * Celdas → filas con las claves que espera import_claims.
+ * Si la primera fila tiene al menos 3 encabezados reconocibles, se usan por nombre;
+ * si no, se asume el orden de la plantilla.
+ */
+export function toClaimRows(cells) {
+  let rows = (cells || []).filter((r) => r && r.some((c) => String(c ?? '').trim() !== ''));
+  if (!rows.length) return [];
+  let map = IMPORT_COLS.map((_, i) => i);
+  const head = rows[0].map(norm);
+  const found = IMPORT_COLS.map((k) => head.findIndex((h) => ALIASES[k].includes(h)));
+  if (found.filter((i) => i >= 0).length >= 3) { map = found; rows = rows.slice(1); }
+  return rows.map((c) => Object.fromEntries(IMPORT_COLS.map((k, i) => [k, map[i] >= 0 ? String(c[map[i]] ?? '').trim() : ''])));
+}
 
