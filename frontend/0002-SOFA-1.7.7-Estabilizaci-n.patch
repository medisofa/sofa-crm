+/**
+ * 1.7.7 · Quita una reclamación de un lote no radicado por public.remove_service_line (060_estabilizacion.sql):
+ * valida rol, estado del lote, pagos, glosas y reenvíos; pide motivo; deja la actividad y borra sus documentos.
+ * Después se quitan del almacenamiento los archivos que devolvió la base.
+ */
+export async function removeLine(id, reason) {
+  const { data, error } = await sb().rpc('remove_service_line', { p_line: id, p_reason: reason });
+  if (error) {
+    if (error.code === 'PGRST202') throw new Error('La base de datos todavía no tiene la migración 060. Pida al administrador que la aplique y vuelva a intentar.');
+    throw error;
+  }
+  const byBucket = {};
+  (data?.files || []).forEach((f) => { if (f?.path) (byBucket[f.bucket || 'claim-documents'] ||= []).push(f.path); });
+  let filesLeft = 0;
+  for (const [bucket, paths] of Object.entries(byBucket)) {
+    const { error: e } = await sb().storage.from(bucket).remove(paths);
+    if (e) filesLeft += paths.length;
+  }
+  return { ...data, filesLeft };
+}
 export async function lookupTariff(procedure, ars, date, provider = null, plan = null) {
